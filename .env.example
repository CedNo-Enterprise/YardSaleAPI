POSTGRES_USER=myuser
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mydatabase

# Full connection string your API uses to connect to Postgres.
# Local dev: postgresql://myuser:mysecretpassword@localhost:5432/mydatabase?sslmode=disable
# Production: provided by your hosting/DB provider
DATABASE_URL=postgresql://myuser:mysecretpassword@localhost:5432/mydatabase?sslmode=disable

# Signing key for JWTs. Generate a real random value — don't reuse this placeholder.
JWT_SECRET=replace-with-a-long-random-string